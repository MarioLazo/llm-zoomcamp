# LLM providers
ANTHROPIC_API_KEY=your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here

# model selection — gemini default: free for light/interactive use.
# CAVEAT (learned running this project): the free tier caps at 20
# requests/DAY (not per-minute) per project+model — eval/llm_eval.py and
# eval/integrity_checks.py alone need ~65 calls combined, so running the
# eval suite will exhaust the daily quota. Switch PRIMARY_LLM=claude
# (metered, no comparable daily cap) before running the eval scripts.
# claude | gemini
PRIMARY_LLM=gemini
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
CLAUDE_SMART_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-2.5-flash

# infra (compose service names)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=interviews
POSTGRES_DSN=postgresql://vault:vault@postgres:5432/vault

# ingestion — switch to /data/real for your real corpus
TRANSCRIPTS_DIR=/data/sample
CHUNK_SIZE=2000
CHUNK_STEP=1000
