# LLM providers
ANTHROPIC_API_KEY=your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here

# model selection
PRIMARY_LLM=claude            # claude | gemini
CLAUDE_FAST_MODEL=claude-3-5-haiku-20241022
CLAUDE_SMART_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-2.5-flash

# infra (compose service names)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=interviews
POSTGRES_DSN=postgresql://vault:vault@postgres:5432/vault

# ingestion
TRANSCRIPTS_DIR=/data/sample     # switch to /data/real for your real corpus
CHUNK_SIZE=2000
CHUNK_STEP=1000
